# Address is read by the init script to assign the interface IP.
# It is not a standard wg setconf field — do not remove the prefix.
#Address = 10.10.0.1/24

[Interface]
PrivateKey = <server-private-key>
ListenPort = 51820

# Add one [Peer] block per client.
# Generate keys with: wg genkey | tee privatekey | wg pubkey > publickey

[Peer]
# friendly name (optional comment)
PublicKey = <client-public-key>
AllowedIPs = 10.10.0.2/32

#[Peer]
#PublicKey = <another-client-public-key>
#AllowedIPs = 10.10.0.3/32
